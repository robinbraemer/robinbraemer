---
import { Effect } from "effect"
import Layout from "../layouts/Layout.astro"
import Marquee from "../components/Marquee.astro"
import ColumnLabel from "../components/ColumnLabel.astro"
import Squiggle from "../components/Squiggle.astro"
import StarIcon from "../components/StarIcon.astro"
import ThemeDot from "../components/ThemeDot.astro"
import ScrollHint from "../components/ScrollHint.astro"
import { profile as config } from "../../../profile.config.ts"
import { loadProfile, ProfileLayer } from "../lib/profile.ts"

const profile = await Effect.runPromise(loadProfile.pipe(Effect.provide(ProfileLayer)))
const topRepos = profile.repos.slice(0, 8)

const languages = ["Go", "TypeScript", "Rust", "Java", "Swift", "Python"]
const platforms = ["Kubernetes", "Docker", "Terraform", "gRPC", "Cloudflare", "PostgreSQL"]

const work = [
  { where: "@akua-dev", role: "Senior SRE & Agentic Platform Engineer", desc: "Agentic platform engineering — building systems where agents operate infrastructure safely." },
  { where: "@minekube", role: "Contributor", desc: "Minecraft networking infrastructure, server proxies and Kubernetes tooling for game networks." },
]

const toPublicPath = (image: string) => "/" + image.replace(/^site\/public\//, "")
// pick readable text over a given badge hex background instead of hardcoding dark text
const badgeTextClass = (hex: string) => {
  const r = parseInt(hex.slice(0, 2), 16)
  const g = parseInt(hex.slice(2, 4), 16)
  const b = parseInt(hex.slice(4, 6), 16)
  const luminance = (r * 299 + g * 587 + b * 114) / 1000
  return luminance > 140 ? "text-stone-900" : "text-stone-50"
}
// bioLong carries **bold** markdown for the README; strip it for plain-text display here
const bioIntroSentence = config.bioLong.split(".")[0]?.replace(/\*\*/g, "")
---

<Layout
  title="Robin Brämer — Agentic Platform Engineer"
  description="Robin Brämer — Senior SRE & Agentic Platform Engineer. Go, Rust, TypeScript, Kubernetes, AI."
>
  <ThemeDot />
  <ScrollHint />

  <main class="flex h-screen flex-col overflow-x-auto scrollbar-hide sm:flex-row">
    <!-- Column 1 — Hero -->
    <div data-column="true" class="flex w-full shrink-0 flex-col sm:w-[32rem] sm:overflow-y-auto sm:border-r sm:border-stone-800">
      <Marquee />
      <div class="px-6 py-8 sm:p-12">
        <img
          src={profile.avatar_url}
          alt={profile.name}
          width={512}
          height={512}
          loading="lazy"
          class="mb-8 aspect-square w-full rounded-lg object-cover"
        />
        <ColumnLabel>Intro</ColumnLabel>
        <p class="text-sm leading-relaxed text-stone-100">
          I am <span class="text-accent font-bold">{profile.name}</span> and this is my website. {bioIntroSentence}.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-stone-500">
          Based in {profile.location || "Germany, Berlin"}. I have enjoyed Rust, Go, TypeScript, Java, and
          Swift. But really, all programming is good. I care about platforms that run themselves —
          reconciliation loops, agents that verify, act, and learn.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-stone-500">
          Currently working on agentic platform engineering at{" "}
          <a href="https://github.com/akua-dev" class="hover-accent text-stone-300 transition-colors">@akua-dev</a>{" "}
          and{" "}
          <a href="https://github.com/Minekube" class="hover-accent text-stone-300 transition-colors">@minekube</a>.
        </p>

        <Squiggle />

        <ColumnLabel>Links</ColumnLabel>
        <ul class="flex flex-col gap-2 text-sm">
          {config.links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noreferrer" class="hover-accent text-stone-300 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <Squiggle />

        <ColumnLabel>Motto</ColumnLabel>
        <p class="font-display text-xl leading-snug text-stone-200">Build the thing that builds the thing.</p>
      </div>
    </div>

    <!-- Column 2 — Featured Projects -->
    <div data-column="true" class="flex w-full shrink-0 flex-col sm:w-[32rem] sm:overflow-y-auto sm:border-r sm:border-stone-800">
      <div class="px-6 py-8 sm:p-12">
        <ColumnLabel>Featured Projects</ColumnLabel>
        <div class="flex flex-col gap-8">
          {config.featuredProjects.map((project) => (
            <a href={project.url} target="_blank" rel="noreferrer" class="group flex flex-col gap-3">
              <img
                src={toPublicPath(project.image)}
                alt={project.title}
                loading="lazy"
                class="aspect-video w-full rounded-lg border border-stone-800 object-cover transition-colors group-hover:border-stone-600"
              />
              <span
                class:list={["w-fit rounded px-2 py-1 text-xs font-bold uppercase tracking-wide", badgeTextClass(project.badge.color)]}
                style={`background-color: #${project.badge.color}`}
              >
                {project.badge.text}
              </span>
              <span class="group-hover-accent text-sm font-bold text-stone-100 transition-colors">
                {project.title}
              </span>
              <span class="text-sm font-light text-stone-500">{project.description}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Column 3 — Assorted Projects -->
    <div data-column="true" class="flex w-full shrink-0 flex-col sm:w-[32rem] sm:overflow-y-auto sm:border-r sm:border-stone-800">
      <div class="px-6 py-8 sm:p-12">
        <ColumnLabel>Assorted Projects</ColumnLabel>
        <div class="flex flex-col">
          {topRepos.map((repo) => (
            <a href={repo.url} target="_blank" rel="noreferrer" class="group flex flex-col border-t border-stone-800 py-4">
              <div class="flex items-start justify-between gap-4">
                <span class="group-hover-accent text-sm font-bold text-stone-100 transition-colors">
                  {repo.name}
                </span>
                <div class="flex shrink-0 items-center gap-2">
                  {repo.stars > 0 && (
                    <span class="flex items-center gap-1 text-xs font-light text-stone-500">
                      <StarIcon class="h-3.5 w-3.5 text-stone-400" />
                      {repo.stars.toLocaleString()}
                    </span>
                  )}
                  <span class="rounded bg-stone-900 px-1.5 py-1 text-xs font-bold text-stone-400">
                    {repo.language || "REPO"}
                  </span>
                </div>
              </div>
              <p class="mt-2 text-sm font-light text-stone-500">{repo.description || "No description."}</p>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Column 4 — Skills -->
    <div data-column="true" class="flex w-full shrink-0 flex-col sm:w-[32rem] sm:overflow-y-auto sm:border-r sm:border-stone-800">
      <div class="px-6 py-8 sm:p-12">
        <ColumnLabel>Languages</ColumnLabel>
        <ul class="flex flex-col gap-2 text-sm">
          {languages.map((lang) => (
            <li class="border-t border-stone-800 py-3 text-stone-200">{lang}</li>
          ))}
        </ul>

        <Squiggle />

        <ColumnLabel>Platforms &amp; Tooling</ColumnLabel>
        <div class="flex flex-wrap gap-2">
          {platforms.map((p) => (
            <span class="rounded bg-stone-900 px-2 py-1 text-xs font-bold text-stone-300">{p}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Column 5 — Work -->
    <div data-column="true" class="flex w-full shrink-0 flex-col sm:w-[32rem] sm:overflow-y-auto sm:border-r sm:border-stone-800">
      <div class="px-6 py-8 sm:p-12">
        <ColumnLabel>Work</ColumnLabel>
        <div class="flex flex-col">
          {work.map((job) => (
            <div class="flex flex-col border-t border-stone-800 py-4">
              <div class="flex items-baseline justify-between gap-4">
                <span class="text-sm font-bold text-stone-100">{job.role}</span>
                <span class="shrink-0 text-xs font-light text-stone-500">{job.where}</span>
              </div>
              <p class="mt-2 text-sm font-light text-stone-500">{job.desc}</p>
            </div>
          ))}
        </div>

        <Squiggle />

        <ColumnLabel>Contact</ColumnLabel>
        <ul class="flex flex-col gap-2 text-sm">
          {config.links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noreferrer" class="hover-accent text-stone-300 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </main>
</Layout>
